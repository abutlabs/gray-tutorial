{
  // Run and Debug (⇧⌘D): pick a configuration, press F5. A breakpoint pauses the code on
  // its line. Node runs the .ts files itself, so there's no build and no source maps.
  // runtimeVersion "26" takes Node 26 from nvm, whatever your default Node is.
  // Lessons 0.3 to 1.2 have a configuration each; after 1.2, adding them is up to you.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Tests: all (npm test)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/client",
      "runtimeVersion": "26",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["test"],
      "autoAttachChildProcesses": true,
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Tests: the open file",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/client",
      "runtimeVersion": "26",
      "runtimeArgs": ["--test"],
      "program": "${file}",
      "autoAttachChildProcesses": true,
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Program: the open file",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/client",
      "runtimeVersion": "26",
      "program": "${file}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Program: hello (0.3)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/client",
      "runtimeVersion": "26",
      "program": "${workspaceFolder}/client/bin/hello.ts",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Tests: time (0.4)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/client",
      "runtimeVersion": "26",
      "runtimeArgs": ["--test"],
      "program": "${workspaceFolder}/client/test/time.test.ts",
      "autoAttachChildProcesses": true,
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Program: now (0.4)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/client",
      "runtimeVersion": "26",
      "program": "${workspaceFolder}/client/bin/now.ts",
