{
  "name": "gray-tutorial",
  "private": true,
  "type": "module",
  "description": "Build a JAM client in TypeScript, one Gray Paper rule at a time.",
  "engines": { "node": ">=26" },
  "scripts": {
    "site": "node tools/need-node.mjs && vitepress dev --open",
    "site:build": "node tools/need-node.mjs && vitepress build",
    "vectors": "node tools/need-node.mjs && node tools/vectors.ts",
    "compare": "node tools/need-node.mjs && node tools/compare.ts",
    "catch-up": "node tools/need-node.mjs && node tools/compare.ts --write",
    "verify": "node tools/need-node.mjs && node tools/verify.ts",
    "screenshots": "node tools/need-node.mjs && node tools/screenshots.ts",
    "test": "node tools/need-node.mjs && node --test \"tools/*.test.ts\"",
    "typecheck": "tsc -p tools",
    "check": "node tools/need-node.mjs && npm run typecheck && npm test && npm run site:build"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "typescript": "7.0.2",
    "vitepress": "1.6.4"
  }
}
