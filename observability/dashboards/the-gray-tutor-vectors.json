 "panels": [
  {
   "id": 100,
   "type": "text",
   "title": "",
   "transparent": true,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 3
   },
   "options": {
    "mode": "markdown",
    "content": "Your client's scoreboard: every official test vector, run whole by `npm run scoreboard`. A vector passes only if your client's answer is all of the vector's. Every run lands here, from lesson 2.6's first board (4 of 1,428) on; the tutorial's *Scoreboard* page lists the lessons where a family crosses the line. *Every vector* lists each vector the run ran, passed or failed, and why: filter its *family* or *result* column to drill in. Pick a scoreboard run in the *run* menu to see its board; *All* shows the latest, and every failure."
   }
  },
  {
   "id": 1,
   "type": "stat",
   "title": "Vectors passing (last run)",
   "description": "How many official vectors passed whole in the latest npm run scoreboard.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "the_gray_tutor_vectors_passed{client=\"$client\"}",
     "refId": "A",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "decimals": 0,
     "noValue": "nothing yet",
     "color": {
      "mode": "fixed",
      "fixedColor": "green"
     }
    },
    "overrides": []
   },
   "options": {
    "graphMode": "none",
    "colorMode": "value",
    "textMode": "value",
    "justifyMode": "center",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "gridPos": {
    "x": 0,
    "y": 3,
    "w": 6,
    "h": 4
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Official vectors",
   "description": "Every official test vector in vectors/, the ones your client doesn't run yet included.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "the_gray_tutor_vectors_total{client=\"$client\"}",
     "refId": "A",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "decimals": 0,
     "noValue": "nothing yet",
     "color": {
      "mode": "fixed",
      "fixedColor": "text"
     }
    },
    "overrides": []
   },
   "options": {
    "graphMode": "none",
    "colorMode": "value",
    "textMode": "value",
    "justifyMode": "center",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "gridPos": {
    "x": 6,
    "y": 3,
    "w": 6,
    "h": 4
   }
  },
  {
   "id": 3,
   "type": "gauge",
   "title": "Passing (last run)",
   "description": "The share of all official vectors that passed whole in the latest scoreboard.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "100 * the_gray_tutor_vectors_passed{client=\"$client\"} / the_gray_tutor_vectors_total{client=\"$client\"}",
     "refId": "A",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "max": 100,
     "decimals": 1,
     "noValue": "nothing yet",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "orange",
        "value": null
       },
       {
        "color": "green",
        "value": 95
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "showThresholdMarkers": false,
    "showThresholdLabels": false
   },
   "gridPos": {
    "x": 12,
    "y": 3,
    "w": 6,
    "h": 4
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Families on the board",
   "description": "How many vector families your client runs at all (tiny and full share one), in the latest scoreboard.",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "expr": "count(last_over_time({job=\"the_gray_tutor\", client=\"$client\", kind=\"scoreboard\", run_id=~\"$run_id\"} | json | step=\"family\" | run=\"true\" | keep family, passed | unwrap passed [$__range]))",
     "refId": "A",
     "queryType": "instant"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "decimals": 0,
     "noValue": "nothing yet",
     "color": {
      "mode": "fixed",
      "fixedColor": "text"
     }
    },
    "overrides": []
   },
   "options": {
    "graphMode": "none",
    "colorMode": "value",
    "textMode": "value",
    "justifyMode": "center",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "gridPos": {
    "x": 18,
    "y": 3,
    "w": 6,
    "h": 4
   }
  },
  {
   "id": 5,
   "type": "table",
   "title": "Each family (last run)",
   "description": "The board, family by family: how many of its vectors passed whole, of how many; a family your client doesn't run yet says so. tiny and full share a row.",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "expr": "last_over_time({job=\"the_gray_tutor\", client=\"$client\", kind=\"scoreboard\", run_id=~\"$run_id\"} | json | step=\"family\" | run=\"true\" | keep family, passed | unwrap passed [$__range])",
     "refId": "A",
     "queryType": "instant"
    },
    {
     "expr": "last_over_time({job=\"the_gray_tutor\", client=\"$client\", kind=\"scoreboard\", run_id=~\"$run_id\"} | json | step=\"family\" | keep family, total | unwrap total [$__range])",
     "refId": "B",
     "queryType": "instant"
    }
   ],
   "transformations": [
    {
     "id": "merge",
     "options": {}
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      },
      "indexByName": {
       "family": 0,
       "Value #A": 1,
       "Value #B": 2
      },
      "renameByName": {
       "Value #A": "passed",
       "Value #B": "of"
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "decimals": 0,
     "custom": {
      "align": "auto"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "passed"
      },
      "properties": [
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-text"
        }
       },
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "green"
        }
       },
       {
        "id": "mappings",
        "value": [
         {
          "type": "special",
          "options": {
           "match": "null",
           "result": {
            "text": "not run yet",
            "color": "text",
            "index": 0
           }
          }
         }
        ]
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "sortBy": [
     {
      "displayName": "family",
      "desc": false
     }
    ]
   },
   "gridPos": {
    "x": 0,
    "y": 7,
    "w": 10,
    "h": 24
   }
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Vectors passing, run by run",
   "description": "The scoreboard's total after each run: the climb from lesson to lesson.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "max by (client) (the_gray_tutor_vectors_passed{client=\"$client\"})",
     "refId": "A",
     "legendFormat": "passing"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "decimals": 0,
     "min": 0,
     "color": {
      "mode": "fixed",
      "fixedColor": "green"
     },
     "custom": {
      "drawStyle": "line",
      "lineInterpolation": "stepAfter",
      "lineWidth": 2,
      "fillOpacity": 15,
      "showPoints": "never",
      "spanNulls": true
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "showLegend": false
    },
    "tooltip": {
     "mode": "single"
    }
   },
   "gridPos": {
    "x": 10,
    "y": 7,
    "w": 14,
    "h": 24
   }
  },
  {
   "id": 51,
   "type": "table",
   "title": "Every vector (last run)",
   "description": "Each vector the latest scoreboard ran, and whether it passed whole; a failure says why. Filter a column (the funnel in its header) to drill into one family, or into the failures. Pick a run in the run menu to see that run's.",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "expr": "{job=\"the_gray_tutor\", client=\"$client\", kind=\"scoreboard\", run_id=~\"$run_id\"} | json | step=\"vector\"",
     "refId": "A",
     "queryType": "range",
     "maxLines": 5000
    }
   ],
   "transformations": [
    {
     "id": "extractFields",
     "options": {
      "source": "labels",
      "format": "json",
      "keepTime": false,
      "replace": false
     }
    },
    {
     "id": "sortBy",
     "options": {
      "sort": [
       {
        "field": "Time",
        "desc": false
       }
      ]
     }
    },
    {
     "id": "groupBy",
     "options": {
      "fields": {
       "family": {
        "operation": "groupby",
        "aggregations": []
       },
       "vector": {
        "operation": "groupby",
        "aggregations": []
       },
       "passed": {
        "operation": "aggregate",
        "aggregations": [
         "last"
        ]
       },
       "why": {
        "operation": "aggregate",
        "aggregations": [
         "last"
        ]
       }
      }
     }
    },
    {
     "id": "sortBy",
     "options": {
      "sort": [
       {
        "field": "vector",
        "desc": false
       }
      ]
     }
    },
    {
     "id": "organize",
     "options": {
      "indexByName": {
       "family": 0,
       "vector": 1,
       "passed (last)": 2,
       "why (last)": 3
      },
      "renameByName": {
       "passed (last)": "result",
       "why (last)": "why"
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto",
      "filterable": true
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "family"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 150
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "result"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 110
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-text"
        }
       },
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "true": {
            "text": "✔ passed",
            "color": "green",
            "index": 0
           },
           "false": {
            "text": "✘ failed",
            "color": "red",
            "index": 1
           }
          }
         }
        ]
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "sortBy": [
     {
      "displayName": "result",
      "desc": false
     }
    ]
   },
   "gridPos": {
    "x": 0,
    "y": 31,
    "w": 24,
    "h": 18
   }
  },
  {
   "id": 50,
   "type": "logs",
   "title": "Vectors that failed",
   "description": "Each vector a scoreboard ran that didn't pass, and the first part of it that differed: where the next fix starts.",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "expr": "{job=\"the_gray_tutor\", client=\"$client\", kind=\"scoreboard\", run_id=~\"$run_id\"} | json | step=\"vector\" | passed=\"false\" | line_format \"FAIL  {{.vector}}  {{.why}}\"",
     "refId": "A",
     "queryType": "range"
    }
   ],
   "options": {
    "showTime": true,
    "wrapLogMessage": false,
    "sortOrder": "Descending",
    "enableLogDetails": true,
    "prettifyLogMessage": false
   },
   "gridPos": {
    "x": 0,
    "y": 49,
    "w": 24,
    "h": 8
   }
  }
 ]
}