    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "expr": "{job=\"gray_tutorial\", client=\"$client\", kind=\"state\", run_id=~\"$run_id\"} | json | step=\"leaf\" | line_format \"depth {{.depth}}  {{.size}}-byte value  {{if .name}}{{.name}}{{else}}{{.key}}{{end}}\"",
